# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# The catalog's own: Ren'Py's run logs, the tests' Ren'Py-side traces (re-made every run), caches.
/log.txt
/traceback.txt
/errors.txt
/trace/*.log
/trace/renpy-*.jsonl
/tools/__pycache__/

# RenForge's live-session files (injected into game/ while its game runs, removed on stop)
/game/00renforge_*
/game/renforge_*
/.renforge/
