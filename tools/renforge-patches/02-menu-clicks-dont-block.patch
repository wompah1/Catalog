+    def _renforge_enters_context(action):
+        """Does running this action enter a new context (and so block until it ends)?"""
+        if action is None:
+            return False
+        actions = action if isinstance(action, (list, tuple)) else [action]
+        names = ("ShowMenu", "MainMenu", "Quit", "QuickLoad", "FileLoad", "Start", "Help")
+        for a in actions:
+            if type(a).__name__ in names:
+                return True
+        return False
 
