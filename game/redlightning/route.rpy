## Red Lightning -- "My Rival Spikes My Sports Drink to Slow Me Down, and I Still Win by a Chest"
## (the Ren'Py pilot, 2026-11-11). Ported from catalog/game/02-engine/storylines/redlightning/:
## redlightning.js (the ladder, the pacing rule, the readouts), widgets.twee and vn-stage.js (the
## stage). The passages are script.rpy (GENERATED by tools/twee2rpy.py from main.twee and
## rungs.twee); the five sex scenes, which DoL's combat engine ran, are written out in
## encounters.rpy; the hub is hub.rpy.
##
## The route plays linear, as the VN does (owner, 2026-11-10: "mostly fully linear"): every day
## has its rung, the evening is his door and then bed, a morning goes straight to the day's rung.
## Free play (the Intro door, Train, Find Thorne, After Hours) isn't part of the pilot.

init -10 python:
    RL = "art/redlightning/"

    # THE BODY's loud line, rung by rung (redlightning.js `feel`): printed once, after the landing's
    # growth beat (<<rl_feel>>).
    RL_FEEL = [None,
        "\"Why are my LIPS tingly?\" you ask the shower, loud enough for the whole corridor. Your nipples answer by standing up.",
        "You lick your lips and your whole mouth goes {i}zzzt{/i}, straight down to your new tits. \"Oh, come ON,\" you moan, delighted.",
        "Everything's turned up: your mouth, your tits, the swing of your arse. \"Who turned me UP?\" you yell at the ceiling.",
        "You bite your lip and nearly come from it. \"My MOUTH,\" you gasp. \"Since when is my MOUTH a—\" You don't finish.",
        "Your arse throbs when you shift. Your mouth waters when you look at him. \"Everything's a hotspot now,\" you announce. \"EVERYTHING.\"",
        "All of you is one big nerve: lips, tits, arse, and the wet new heat between your thighs. \"Oh my GOD,\" you moan. \"I'm ALL hotspot!\"",
    ]

    # THE MARGIN (the hub's first line) and who calls it. Words, never times.
    RL_MARGIN = [
        ("by a street", "Lenny, at full volume"),
        ("by a street", "Lenny, at full volume"),
        ("by daylight", "Coach, into his clipboard"),
        ("by a stride", "you, flat on the tartan"),
        ("by a step", "Imogen, who has stopped pretending not to watch him"),
        ("by a chest", "the announcer, tripping over he and she"),
        ("a dead heat", "Imogen, on the last lap"),
    ]

    RL_BOTTLES = [None,
        ("neon pink", "recharge formula"),
        ("electric blue", "hydrate before you dehydrate"),
        ("virulent green", "vitamin-enriched; doctor said fluids"),
        ("traffic-cone orange", "the first one you asked for"),
        ("pastel", "taken at the blocks before he offered"),
        None,
    ]

    RL_EXCUSES = [None,
        ["Gains. Obviously gains.", "It's the good halls soap."],
        ["Laundry's shrinking everything except where it counts."],
        ["Hormonal weather, apparently. The doctor said it, so."],
        ["Spiked. Still winning."],
        ["He keeps changing the colour. I keep winning."],
        ["Same old NAME. More bounce."],
    ]

    # VISUAL-NOVEL DAYS: a morning with nothing to land (Redlightning Wake), by the rung you're on.
    RL_WAKES = [
        "Track Halls. Somebody's protein shaker rattling in the kitchen. Miles's door across from yours is open and his room's empty: he's always first down. \"BIG DAY!\" you tell the corridor. Somebody tells you to shut up.",
        "You wake up glossy. The sheet slides off you like you're buttered. You run a palm down your glass-smooth chest, catch a nipple, and laugh your new laugh at the ceiling. {i}Ha-ha-la.{/i}",
        "Your tits are the first thing you feel. Small, soft, sore in the best way, nipples already up. You squeeze them good morning and nearly don't make it to breakfast. \"Laundry,\" you tell them.",
        "You roll over and they roll over a beat late. {i}Flump.{/i} Your thighs brush when you stand. You grab your own arse on the way to the shower, because it's right there and it's GREAT.",
        "Coach's sports bra is drying on the radiator. Your tits are in your hands before your eyes are open. \"Morning, girls,\" you tell them, and bounce them, and moan a bit, and get up anyway.",
        "Your arse still hums from the shed. Your tiny cock's a sticky nothing against the sheet. Across the corridor Miles's door is open a crack, and you grin at it all the way to the shower.",
        "Red hair all over your pillow. You stretch, and everything bounces, and you laugh out loud at nobody.",
    ]

    # Where each rung starts (redlightning.js redlightningRungPassage).
    RL_RUNG_LABEL = {1: "rl_pink", 2: "rl_blue", 3: "rl_green", 4: "rl_orange", 5: "rl_meet", 6: "rl_girlfriend"}

    # ---- the ladder -----------------------------------------------------------------------
    def rl_init():
        if not rl.intro:
            rl.intro = True
            rl.landed = 0
        store.vn_route = "redlightning"

    def rl_advance(n):
        """A rung starts: the ladder moves, the day is stamped (and its session had), the bottle
        changes colour. Once."""
        if (rl.tier or 0) < n:
            rl.tier = n
            rl.rung_day = vn_clock.day
            rl.session_day = vn_clock.day
            if RL_BOTTLES[n]:
                rl.bottle = n

    def rl_land():
        """The overnight landing: the current rung's body, once."""
        t = rl.tier or 0
        if (rl.landed or 0) >= t:
            return False
        rl.landed = t
        rl.feel_pending = t
        return True

    def rl_take_feel():
        n = rl.feel_pending
        rl.feel_pending = None
        return RL_FEEL[n] if n else None

    def rl_kit():
        """The running kit goes on at the start of every session (redlightning_kit)."""
        rl.fit = None

    def rl_run():
        """THE RUN: the band rises with the rung, the skill is never lowered (redlightning_run).
        It only colours how the win reads."""
        lo = 200 + (rl.tier or 0) * 110
        return rl.athletics >= renpy.random.randint(lo, lo + 300)

    def rl_late():
        h = vn_clock.hour
        return h >= 19 or h < 6

    def rl_due():
        """THE PACING RULE (Redlightning.due): "opener", "rung" or None."""
        if not rl.intro or rl.done:
            return None
        if not rl.opener:
            return "opener"
        t = rl.tier or 0
        if t >= 6 or (rl.landed or 0) < t:
            return None
        if (rl.session_day if rl.session_day is not None else -1) >= vn_clock.day:
            return None
        return "rung"

    def rl_forward():
        """The hub's way on when no rung's link plays right now (Redlightning.forward): "sleep",
        ("wait", hour, label), or None when the rung's own link is the way on."""
        if not rl.intro or rl.done:
            return None
        t, due, h = rl.tier or 0, rl_due(), vn_clock.hour
        if h < 6:
            return "sleep"
        if due and t == 5:
            return None if h >= 19 else ("wait", 20, "Wait for tonight")
        if due and not rl_late():
            return None
        return "sleep"

    def rl_straight():
        """LINEAR DAYS: a morning's way straight to today's rung, (label, link text), or None."""
        if rl.done:
            return None
        t = rl.tier or 0
        if t >= 5 or rl_due() != "rung":
            return None
        return (RL_RUNG_LABEL[t + 1], "The big meet" if t == 4 else "Afternoon session")

    def rl_excuse():
        t = rl.tier or 0
        if t < 1:
            return None
        pool = RL_EXCUSES[min(t, 6)]
        i = 1 if t == 1 and rl.blame == "soap" else 0
        return pool[min(i, len(pool) - 1)].replace("NAME", store.rl_pc_name or "me")

    def rl_status():
        """The hub's readouts (redlightning_status): the margin first, never a number."""
        t = max(0, min(6, rl.tier or 0))
        m, who = RL_MARGIN[t]
        out = ["{color=#ffd700}The margin:{/color} {color=#ff5fb8}%s{/color} {color=#b7b7b7}(%s){/color}" % (m, who)]
        e = rl_excuse()
        if e:
            out.append("{color=#ffd700}What's going on with you:{/color} {color=#08c1c1}\"%s\"{/color}" % e)
        if t >= 6:
            out.append("{color=#ffd700}The bottle:{/color} none. There doesn't need to be.")
        elif rl.bottle:
            c, lab = RL_BOTTLES[rl.bottle]
            out.append("{color=#ffd700}The last bottle:{/color} %s {color=#b7b7b7}(\"%s\"){/color}" % (c, lab))
        out.append("{color=#ffd700}The squad calls you:{/color} {color=#ec3535}%s{/color}" % store.rl_nick)
        return "\n".join(out)

    def rl_wake():
        return RL_WAKES[max(0, min(6, rl.tier or 0))]

    # ---- the stage (vn-stage.js) ----------------------------------------------------------
    def rl_rung():
        """Rory's body is the rung that has LANDED (the morning after each bottle)."""
        return max(1, min(6, rl.landed or 0))

    def rl_default_bg(loc):
        if loc == "home":
            return "rl_bedroom"
        if loc == "town":
            return "rl_karaoke"
        return "rl_track_dusk" if rl_late() else "rl_track"

    _rl_have = {}

    def _rl_has(n):
        if n not in _rl_have:
            _rl_have[n] = renpy.loadable(RL + n + ".png")
        return _rl_have[n]

    def rl_pc_file(face):
        """The sprite that exists: the outfit set with this face, else the outfit set with the
        default face, else the plain body with this face, else the default (vn-screen.js sprite())."""
        r, fit = rl_rung(), rl.fit
        names = []
        if fit:
            names += ["pc-r%d-%s-%s" % (r, fit, face), "pc-r%d-%s-grin" % (r, fit)]
        names += ["pc-r%d-%s" % (r, face), "pc-r%d-grin" % r]
        for n in names:
            if _rl_has(n):
                return RL + n + ".png"
        return RL + names[-1] + ".png"

    def rl_face_now():
        a = renpy.get_attributes("rory")
        return a[0] if a else "grin"

    def _rl_portrait(st, at):
        p = rl_pc_file(rl_face_now())
        x, y, w, h = redlightning_face_crops.get(p.rsplit("/", 1)[-1][:-4], (0, 0, 200, 200))
        return Transform(Crop((x, y, w, h), p), xysize=(VN_FACE, VN_FACE)), None

    vn_portraits["redlightning"] = lambda: DynamicDisplayable(_rl_portrait)

    def rl_hub_cast():
        t = rl.tier or 0
        return [("miles", "hungry" if t >= 4 else "neutral")] if t >= 1 and not rl.done else []

    def rl_door_cast():
        t = rl.tier or 0
        return [("miles", "hungry" if t >= 5 else "blush" if t >= 2 else "neutral")]

    vn_sprite_image("rory", ("grin", "flushed", "shocked"), rl_pc_file, who="pc")
    vn_sprite_image("miles", ("neutral", "blush", "hungry"), lambda f: RL + "miles-" + f + ".png")

    # Every picture in the route's folder is a background and a CG by name ("bg rl_track",
    # "cg rl_drink_pink"); the scene-art pictures are CGs as "cg rl_sa_<name>".
    for _f in renpy.list_files():
        if _f.startswith(RL) and _f.endswith(".jpg"):
            _n = _f[len(RL):-4]
            if _n.startswith("scenes/"):
                vn_register_cg("rl_sa_" + _n[7:], _f)
            else:
                vn_register_bg("rl_" + _n.replace("-", "_"), _f)
                vn_register_cg("rl_" + _n.replace("-", "_"), _f)

    vn_register_route("redlightning",
        "My Rival Spikes My Sports Drink to Slow Me Down, and I Still Win by a Chest",
        "You're the university's sprint ace, and the squad calls you Red Lightning after the streak of hair going past. Miles Thorne has finished second to you for two seasons. At the opener you beat him by a street and tell him he'll have you next time. Next session he hands you something neon pink he mixed himself. You drink it in one go and ask if it's meant to grow you a pair of tits to match your ego. It is. You keep winning anyway.",
        RL + "cover.jpg", "redlightning_start")

    achievement.register("Every Bottle After")
    achievement.register("Best Mates Forever")

default rl = VNState(athletics=850, tier=0, landed=0)
default rl_enc = VNState(partner_came=True, pc_orgasms=1)
default rl_pc_name = "Rory"
default rl_pc_surname = "Flynn"
## The nickname follows the hair (redlightningName); the route's hair is red, start to finish.
default rl_nick = "Red Lightning"
default rl_NICK = "RED LIGHTNING"

## The VN script's speakers (vn-stage.js `names`): Rory in the route's red, Miles blue; the
## squad, Coach and the doctor have plates but no sprites.
define rl_rory = VNChar("[rl_pc_name]", who="pc", plate="#d4313d")
define rl_miles = VNChar("Miles", who="miles", plate="#3570c9")
define rl_imogen = VNChar("Imogen", who="imogen", plate="#7b5fb0")
define rl_lenny = VNChar("Lenny", who="lenny", plate="#b8782a")
define rl_roxy = VNChar("Roxy", who="roxy", plate="#c24d8c")
define rl_coach = VNChar("Coach", who="coach", plate="#4f7f4e")
define rl_doc = VNChar("Dr. Fairweather", who="doc", plate="#3f8f8c")
define rl_unk = VNChar("???", who="???", plate="#6b6b78")

## Route select's entry.
label redlightning_start:
    $ rl = VNState(athletics=850, tier=0, landed=0)
    $ rl_enc = VNState(partner_came=True, pc_orgasms=1)
    $ vn_clock = VNState(day=0, hour=12, minute=0)
    ## The route card's name box (DoL's New Game menu): Rory unless you change it. "Rory" works
    ## as a girl's name, so it never changes on its own; the nickname follows the hair, not this.
    ## A test walk (game/tests/) keeps Rory.
    if not renpy.session.get("vn_picks"):
        $ rl_pc_name = renpy.input("Your name? (Rory, unless you'd like another.)", default="Rory", length=20).strip() or "Rory"
    jump rl_opening

## The end of the route (vn.twee's <<route_return>>: "Choose another story").
label rl_route_return:
    $ persistent.catalog_done = (persistent.catalog_done or set()) | {"redlightning"}
    $ vn_route = None
    window hide
    scene black onlayer bgl
    $ renpy.scene(layer="master")
    $ renpy.scene(layer="cgl")
    with Dissolve(0.8)
    centered "{size=+10}{color=#d4313d}Red Lightning{/color}{/size}\n\n{i}The end.{/i}"
    ## "Choose another story" (vn.twee's <<route_return>>): back to the route select
    jump start
